{
  "schemaVersion": 1,
  "distributionVersion": "1.1.1",
  "repository": "https://github.com/Quriov/Quriov-MCP",
  "releaseTag": "v1.1.1",
  "commitPinSource": "website_prompt",
  "manifestHashAlgorithm": "sha256",
  "manifestHashSource": "website_prompt",
  "endpoint": "https://quriovai.com/mcp/v1",
  "scope": "mcp",
  "allowedNetworkTargets": [
    "https://quriovai.com/mcp/v1",
    "https://quriovai.com/api/v1/mcp/uploads"
  ],
  "doctor": {
    "entrypoint": "bin/quriov-mcp-doctor.mjs",
    "minimumNodeVersion": "20",
    "credentialInputs": [
      "stdin",
      "QURIOV_MCP_ACCESS_KEY"
    ],
    "writesConfiguration": false
  },
  "cli": {
    "entrypoint": "bin/quriov.mjs",
    "guide": "CLI.md",
    "installTarball": "https://github.com/Quriov/Quriov-MCP/releases/download/v1.1.1/quriov-mcp-distribution-1.1.1.tgz",
    "minimumNodeVersion": "20",
    "dependencies": [],
    "credentialInputs": [
      "QURIOV_MCP_ACCESS_KEY",
      "QURIOV_MCP_KEY",
      "QURIOV_ACCESS_KEY",
      "stdin",
      "quriov login user config file"
    ],
    "networkTargets": [
      "https://quriovai.com/mcp/v1",
      "https://quriovai.com/api/v1/mcp/uploads"
    ],
    "resultDownloads": "presigned https URLs returned by the MCP tools, fetched with GET and without the key",
    "writes": [
      "its own credentials file under the user config directory (quriov login)",
      "batch outputs, cost.csv and .quriov/ state under the chosen output folder"
    ],
    "spendsCredit": "only after a server-side estimate and explicit confirmation (--yes when non-interactive)"
  },
  "clients": {
    "codex": {
      "recipe": "recipes/codex.md",
      "support": "trusted_agent_install",
      "userScopeConfiguration": "~/.codex/config.toml"
    },
    "claudeCode": {
      "recipe": "recipes/claude-code.md",
      "support": "trusted_agent_install",
      "userScopeConfiguration": "~/.claude.json"
    },
    "cursor": {
      "recipe": "recipes/cursor.md",
      "support": "ai_assisted_unverified",
      "userScopeConfiguration": "~/.cursor/mcp.json"
    }
  },
